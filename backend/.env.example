# EcoLink Django Backend Environment Variables
SECRET_KEY=django-insecure-some-development-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration (PostgreSQL Connection String or Individual Parameters)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecolink_db
# Alternatively use individual variables:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=ecolink_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

